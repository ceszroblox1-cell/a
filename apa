-- ========== FUNGSI UTAMA ==========

-- Fungsi untuk membeli seed
local function buySeed(seedName)
    local buyRemote = remoteEvents:FindFirstChild("BuySeed")
    if buyRemote then
        pcall(function()
            buyRemote:FireServer(seedName)
            print("[Auto Buy] Membeli seed: " .. seedName)
        end)
    else
        warn("Remote 'BuySeed' tidak ditemukan!")
    end
end

-- Fungsi untuk menanam seed
local function plantSeed(seedName)
    local plantRemote = remoteEvents:FindFirstChild("PlantSeed")
    if plantRemote then
        pcall(function()
            plantRemote:FireServer(seedName) -- mungkin butuh posisi, sesuaikan
            print("[Auto Plant] Menanam: " .. seedName)
        end)
    else
        warn("Remote 'PlantSeed' tidak ditemukan!")
    end
end

