-- ========== LOOP AUTO FARM ==========

local autoFarmEnabled = false
local autoBuyEnabled = false
local autoSellEnabled = false

local selectedSeed = "Carrot" -- seed default

-- Fungsi utama loop
local function autoFarmLoop()
    while autoFarmEnabled do
        -- 1. Panen
        harvest()
        wait(0.5)
        
        -- 2. Siram
        water()
        wait(0.5)
        
        -- 3. Tanam (jika ada lahan kosong)
        plantSeed(selectedSeed)
        wait(0.5)
        
        -- 4. Ambil item jatuh
        collectDropped()
        wait(0.5)
        
        -- 5. Jual jika diaktifkan
        if autoSellEnabled then
            sellFruit()
            wait(0.5)
        end
        
        -- 6. Beli seed jika diaktifkan
        if autoBuyEnabled then
            buySeed(selectedSeed)
            wait(0.5)
        end
        
        wait(1) -- jeda antar siklus
    end
end

